{
  auto_https off
  admin off
}
:80 {
  encode gzip zstd
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy no-referrer
  }
  handle /api/* {
    reverse_proxy api:8000
  }
  handle /health/* {
    reverse_proxy api:8000
  }
  redir /admin /admin/ 308
  handle_path /admin/* {
    reverse_proxy admin-web:80
  }
  handle {
    reverse_proxy user-h5:80 {
      header_down Cache-Control "no-store"
    }
  }
}
