{
  admin off
  auto_https off
  log default {
    output file /var/log/caddy/runtime.log {
      roll_size 20MiB
      roll_keep 10
    }
  }
}
:80 {
  log {
    output file /var/log/caddy/access.log {
      roll_size 20MiB
      roll_keep 10
    }
  }
  root * /srv/admin
  try_files {path} /index.html
  file_server
}
