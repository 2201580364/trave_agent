[Unit]
Description=Travel Agent MySQL and Redis backup
Requires=docker.service
After=docker.service
ConditionPathExists=/opt/travel-agent/infra/scripts/backup.sh
ConditionPathExists=/etc/travel-agent/infra.env

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
ExecStart=/usr/bin/bash /opt/travel-agent/infra/scripts/backup.sh
