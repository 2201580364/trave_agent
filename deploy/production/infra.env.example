# This file is documentation only. Real values are generated on the server at
# /etc/travel-agent/infra.env with mode 0600 and must never be committed.

MYSQL_ROOT_PASSWORD=<generated-on-server>
MYSQL_DATABASE=travel_agent
MYSQL_APP_USER=travel_agent_app
MYSQL_APP_PASSWORD=<generated-on-server>
MYSQL_MIGRATION_USER=travel_agent_migration
MYSQL_MIGRATION_PASSWORD=<generated-on-server>
MYSQL_BACKUP_USER=travel_agent_backup
MYSQL_BACKUP_PASSWORD=<generated-on-server>
MYSQL_BIND_PORT=13306

REDIS_APP_USER=travel_agent
REDIS_PASSWORD=<generated-on-server>
REDIS_ADMIN_USER=travel_agent_admin
REDIS_ADMIN_PASSWORD=<generated-on-server>
REDIS_BIND_PORT=16379
REDIS_KEY_PREFIX=travel-agent
