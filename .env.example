# Copy this file to .env and replace only the values needed locally.
# Never put real credentials in .env.example and never commit .env.

# Database
TRAVEL_AGENT_DATABASE_URL=sqlite:///./.local/travel_agent.db
TRAVEL_AGENT_DATABASE_ECHO=false
TRAVEL_AGENT_DB_POOL_SIZE=5
TRAVEL_AGENT_DB_MAX_OVERFLOW=10
TRAVEL_AGENT_DB_POOL_RECYCLE_SECONDS=1800
TRAVEL_AGENT_DB_POOL_TIMEOUT_SECONDS=30

# Gaode Web Service API
TRAVEL_AGENT_GAODE_API_KEY=
TRAVEL_AGENT_GAODE_CITY_CODE=330100
TRAVEL_AGENT_GAODE_TIMEOUT_SECONDS=5
TRAVEL_AGENT_GAODE_CACHE_TTL_SECONDS=86400
TRAVEL_AGENT_GAODE_DATA_VERSION=gaode-hangzhou-local-v1
TRAVEL_AGENT_GAODE_MODES=walking,transit,driving

# QWeather three-day forecast API
# Use the project-specific HTTPS API Host shown in the QWeather console.
TRAVEL_AGENT_QWEATHER_API_KEY=
TRAVEL_AGENT_QWEATHER_LOCATION_ID=101210101
TRAVEL_AGENT_QWEATHER_TIMEOUT_SECONDS=5
TRAVEL_AGENT_QWEATHER_DATA_VERSION=qweather-hangzhou-local-v1
TRAVEL_AGENT_QWEATHER_BASE_URL=https://devapi.qweather.com

# Immutable published solver snapshot used by the production-style HTTP app.
# The selected JSON must be status=published and all routing points human_verified.
TRAVEL_AGENT_PUBLISHED_SNAPSHOT_ROOT=./var/published
TRAVEL_AGENT_PUBLISHED_CITY_ID=hangzhou
TRAVEL_AGENT_PUBLISHED_SNAPSHOT_VERSION=
